{
  "name": "pipeline-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Projeto de exemplo para demonstrar um pipeline completo no GitHub Actions + Vercel",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "eslint .",
    "build": "node scripts/build.js",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:integration": "node --test \"tests/integration/**/*.test.js\"",
    "test:coverage": "c8 --all --src=src --src=api --check-coverage --lines 90 --functions 90 --branches 80 --reporter=text --reporter=lcov node --test \"tests/**/*.test.js\"",
    "test:perf": "node tests/perf/load.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "dev": "npm run build && node scripts/dev-server.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "autocannon": "^8.0.0",
    "c8": "^10.1.3",
    "eslint": "^9.17.0",
    "globals": "^15.14.0"
  }
}
